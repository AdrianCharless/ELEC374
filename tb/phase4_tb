    initial begin
        reset      = 1;
        stop       = 0;
        ExternalIn = 32'h000000E0;
        load_memory;
        #20;
        reset = 0;
        #2000000;

        $display("R0  expected=0x00000614  got=0x%h  %s", uut.DP.R0.BusMuxIn_R0,  (uut.DP.R0.BusMuxIn_R0  == 32'h00000614) ? "PASS":"FAIL");
