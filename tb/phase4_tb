    reg        reset;
    reg        stop;
    reg [31:0] ExternalIn;

    wire [31:0] OutPort;
    wire        Run;

    cpu uut (
        .clock      (clk),
        .reset      (reset),
        .stop       (stop),
        .ExternalIn (ExternalIn),
        .OutPort    (OutPort),
        .Run        (Run)
